# Variables du worker ft-moulinette (aucun secret). Copier en deploy/ovh/worker.env.
EXECUTION_BACKEND=cloudrun
FTM_ENVIRONMENT=production
GCP_PROJECT_ID=
GCP_REGION=europe-west1
CLOUD_RUN_URL=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp_invoker
# key (clé JSON, bêta privée) ou wif (Workload Identity Federation, recommandé) :
GCP_AUTH_MODE=key
GCP_INVOKER_SERVICE_ACCOUNT=
EXECUTION_TIMEOUT=60
MAX_CONCURRENT_JOBS=2
REDIS_URL=redis://redis:6379/0
# Quotas applicatifs (docs/cloudrun-costs.md)
FTM_QUOTA_USER_DAILY=20
FTM_QUOTA_USER_CONCURRENT=1
FTM_QUOTA_GLOBAL_DAILY=300
FTM_QUOTA_MAX_IN_FLIGHT=20
FTM_QUOTA_MIN_INTERVAL=10
# Interrupteur administrateur : 1 suspend toute nouvelle exécution distante
FTM_EXECUTIONS_DISABLED=
