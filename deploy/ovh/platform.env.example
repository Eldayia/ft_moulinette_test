# Variables de la plateforme sur le VPS (aucun secret ici). Copier en deploy/ovh/platform.env.
# Secrets, hors dépôt, droits 0400 : deploy/ovh/secrets/postgres_password et deploy/ovh/secrets/gcp_invoker.json
FTM_PUBLIC_ORIGIN=https://moulinette.example
PROXY_NETWORK=proxy
CLOUD_RUN_URL=
GCP_PROJECT_ID=
GCP_REGION=europe-west1
# key (clé JSON, bêta privée) ou wif (Workload Identity Federation) + compte à emprunter
GCP_AUTH_MODE=key
GCP_INVOKER_SERVICE_ACCOUNT=
EXECUTION_TIMEOUT=60
MAX_CONCURRENT_JOBS=2
# Quotas applicatifs (docs/cloudrun-costs.md)
FTM_QUOTA_USER_DAILY=20
FTM_QUOTA_USER_CONCURRENT=1
FTM_QUOTA_GLOBAL_DAILY=300
FTM_QUOTA_MAX_IN_FLIGHT=20
FTM_QUOTA_MIN_INTERVAL=10
# Estimation de coût affichée aux administrateurs (prix par seconde d'exécution, d'après les tarifs officiels)
FTM_COST_PER_SECOND=0
# 1 : suspend toutes les exécutions (l'interrupteur de la page d'administration agit sans redémarrage)
FTM_EXECUTIONS_DISABLED=
