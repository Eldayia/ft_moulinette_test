<idea-plugin>
  <id>fr.moulinette.libft</id>
  <name>42 Libft Moulinette</name>
  <vendor>ft-moulinette</vendor>
  <description>Run Libft checks on the project or the current file.</description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <action id="Moulinette.Project" class="fr.moulinette.ProjectAction" text="Moulinette: tester le projet">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="Moulinette.File" class="fr.moulinette.FileAction" text="Moulinette: tester le fichier">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
