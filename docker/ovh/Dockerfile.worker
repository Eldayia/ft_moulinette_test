# syntax=docker/dockerfile:1
# Worker du VPS : consomme la file Redis/RQ et délègue l'exécution au service Cloud Run.
# Ne contient aucun outil de compilation : aucune soumission n'est compilée ni exécutée sur le VPS.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY workers/dispatcher/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --no-compile -r /app/requirements.txt && rm -rf /root/.cache
COPY runners/ft_moulinette_runners/ /app/ft_moulinette_runners/
COPY workers/dispatcher/ftm_dispatcher/ /app/ftm_dispatcher/
RUN set -eux; find /app -name '__pycache__' -prune -exec rm -rf {} +; \
    useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin worker; \
    ! command -v gcc; ! command -v cc; ! command -v make
USER 10001
WORKDIR /app
CMD ["sh", "-c", "exec rq worker-pool --url \"$REDIS_URL\" --num-workers \"${MAX_CONCURRENT_JOBS:-2}\" ftm-submissions"]
