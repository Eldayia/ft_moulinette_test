!platform/api/ftm_platform/
!platform/api/requirements.txt
!platform/web/
platform/web/node_modules
platform/web/build
platform/web/.svelte-kit
!docker/cloudrun/
!docker/ovh/
**/__pycache__
**/*.pyc
